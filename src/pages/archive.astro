---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

const allPosts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
    (a, b) => b.data.published.valueOf() - a.data.published.valueOf(),
);

const allCategories = [...new Set(allPosts.map((p) => p.data.category))];
const allTags = [...new Set(allPosts.flatMap((p) => p.data.tags))];

function schoolClass(category: string) {
    const map: Record<string, string> = {
        Malware: "school-malware",
        "Windows Internals": "school-internals",
    };
    return map[category] ?? "school-default";
}

function readingTime(body: string) {
    return Math.max(1, Math.round(body.trim().split(/\s+/).length / 200));
}

// Serialize all posts to JSON so the client script can filter them
const postsJson = JSON.stringify(
    allPosts.map((p) => ({
        slug: p.slug,
        title: p.data.title,
        description: p.data.description ?? null,
        category: p.data.category,
        tags: p.data.tags,
        date: p.data.published.toISOString().slice(0, 10),
        minutes: readingTime(p.body),
        schoolClass: schoolClass(p.data.category),
    })),
);
---

<Base title="Archive — Solitär Grimoire">
    <div class="article-wrapper">
        <a href="/" class="article-back">← Back to grimoire</a>

        <h1
            style="font-family: 'Cinzel Decorative', serif; font-size: 22px; color: var(--text-primary); margin-bottom: 1.5rem; letter-spacing: 2px;"
        >
            Archive
        </h1>

        <!-- Search bar -->
        <div style="position: relative; margin-bottom: 1.5rem;">
            <input
                id="archive-search"
                type="text"
                placeholder="search inscriptions…"
                autocomplete="off"
                style="
                    width: 100%;
                    box-sizing: border-box;
                    background: var(--bg-card, rgba(255,255,255,0.03));
                    border: 1px solid var(--border-rune, rgba(255,255,255,0.1));
                    border-radius: 6px;
                    padding: 0.55rem 2.4rem 0.55rem 0.85rem;
                    color: var(--text-primary);
                    font-family: var(--font-mono, monospace);
                    font-size: 0.85rem;
                    outline: none;
                    transition: border-color 0.2s ease;
                "
            />
            <span
                style="
                position: absolute;
                right: 0.75rem;
                top: 50%;
                transform: translateY(-50%);
                color: var(--text-muted);
                font-size: 0.8rem;
                pointer-events: none;
            "
                >⌕</span
            >
        </div>

        <!-- Category filters -->
        <div
            id="category-filters"
            style="display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 1rem;"
        >
            <button class="tag filter-btn" data-type="category" data-value=""
                >all</button
            >
            {
                allCategories.map((cat) => (
                    <button
                        class="tag filter-btn"
                        data-type="category"
                        data-value={cat}
                    >
                        {cat}
                    </button>
                ))
            }
        </div>

        <!-- Tag filters -->
        <div
            id="tag-filters"
            style="display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 2rem;"
        >
            {
                allTags.map((tag) => (
                    <button
                        class="tag filter-btn"
                        data-type="tag"
                        data-value={tag}
                    >
                        #{tag}
                    </button>
                ))
            }
        </div>

        <p id="archive-label" class="section-heading"></p>

        <div id="spell-list"></div>
    </div>
</Base>

<script define:vars={{ postsJson }}>
    const posts = JSON.parse(postsJson);

    const searchInput = document.getElementById("archive-search");
    let searchQuery = "";

    function getParams() {
        const p = new URLSearchParams(window.location.search);
        return { category: p.get("category") ?? "", tag: p.get("tag") ?? "" };
    }

    function render() {
        const { category, tag } = getParams();

        // Highlight active filter buttons
        document.querySelectorAll(".filter-btn").forEach((btn) => {
            const type = btn.dataset.type;
            const value = btn.dataset.value;
            const active =
                (type === "category" && value === category && !tag) ||
                (type === "tag" && value === tag && !category) ||
                (type === "category" && value === "" && !category && !tag);
            btn.style.color = active ? "var(--teal-bright)" : "";
            btn.style.borderColor = active ? "var(--border-rune)" : "";
            btn.style.background = active ? "var(--teal-ghost)" : "";
        });

        // Filter posts — category/tag AND search query
        const q = searchQuery.trim().toLowerCase();
        const filtered = posts.filter((p) => {
            if (category && p.category !== category) return false;
            if (tag && !p.tags.includes(tag)) return false;
            if (q) {
                const haystack = [
                    p.title,
                    p.description ?? "",
                    p.category,
                    ...p.tags,
                ]
                    .join(" ")
                    .toLowerCase();
                if (!haystack.includes(q)) return false;
            }
            return true;
        });

        const label = category || (tag ? `#${tag}` : "All Inscriptions");
        document.getElementById("archive-label").textContent =
            `${label} — ${filtered.length} spell${filtered.length !== 1 ? "s" : ""}`;

        const list = document.getElementById("spell-list");
        if (filtered.length === 0) {
            list.innerHTML = `<p style="font-family: 'IM Fell English', serif; font-style: italic; color: var(--text-muted);">No inscriptions found for this filter.</p>`;
            return;
        }

        list.innerHTML = filtered
            .map(
                (p) => `
      <a href="/posts/${p.slug}" class="spell-entry" style="display: block;">
        <div class="spell-meta">
          <span class="spell-date">${p.date}</span>
          <span class="spell-school ${p.schoolClass}">${p.category}</span>
          <div class="spell-tags-inline">
            ${p.tags.map((t) => `<span class="spell-tag-inline">${t}</span>`).join("")}
          </div>
        </div>
        <h2 class="spell-title">${p.title}</h2>
        ${p.description ? `<p class="spell-incantation">${p.description}</p>` : ""}
        <div class="spell-footer">
          <span class="spell-read">Read spell →</span>
          <span class="spell-stats"><span>${p.minutes} min</span></span>
        </div>
      </a>
    `,
            )
            .join("");
    }

    searchInput.addEventListener("input", () => {
        searchQuery = searchInput.value;
        render();
    });

    document.addEventListener("keydown", (e) => {
        if (e.key === "/" && document.activeElement !== searchInput) {
            e.preventDefault();
            searchInput.focus();
        }
        if (e.key === "Escape" && document.activeElement === searchInput) {
            searchInput.value = "";
            searchQuery = "";
            render();
            searchInput.blur();
        }
    });

    document.querySelectorAll(".filter-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
            const type = btn.dataset.type;
            const value = btn.dataset.value;
            const url = value
                ? `/archive?${type}=${encodeURIComponent(value)}`
                : "/archive";
            window.history.pushState({}, "", url);
            render();
        });
    });

    window.addEventListener("popstate", render);
    render();
</script>

<style>
    #archive-search:focus {
        border-color: var(--teal-bright, #2dd4bf) !important;
    }

    #archive-search::placeholder {
        color: var(--text-muted);
        opacity: 0.6;
    }
</style>
