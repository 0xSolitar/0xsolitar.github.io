---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { Image } from "astro:assets";

export async function getStaticPaths() {
    const posts = await getCollection("posts", ({ data }) => !data.draft);

    // Sort oldest → newest: index 0 = oldest, last index = newest
    // prevPost = older, nextPost = newer (conventional blog direction)
    const sorted = posts.sort(
        (a, b) => a.data.published.getTime() - b.data.published.getTime(),
    );

    return sorted.map((post, index) => ({
        params: { slug: post.slug },
        props: {
            post,
            prevPost: index > 0 ? sorted[index - 1] : null,
            nextPost: index < sorted.length - 1 ? sorted[index + 1] : null,
        },
    }));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content } = await post.render();

function readingTime(body: string) {
    return Math.max(1, Math.round(body.trim().split(/\s+/).length / 200));
}

function schoolClass(category: string) {
    const map: Record<string, string> = {
        Malware: "school-malware",
        "Windows Internals": "school-internals",
    };
    return map[category] ?? "school-default";
}

const minutes = readingTime(post.body);
const dateStr = post.data.published.toISOString().slice(0, 10);
---

<Base
    title={`${post.data.title} — Solitär Grimoire`}
    description={post.data.description}
>
    <div class="article-wrapper">
        <a href="/" class="article-back">← Back to grimoire</a>

        <header class="article-header">
            <div class="article-meta">
                <span class="spell-date">{dateStr}</span>
                <span class={`spell-school ${schoolClass(post.data.category)}`}>
                    {post.data.category}
                </span>
                <div class="spell-tags-inline">
                    {
                        post.data.tags.map((tag) => (
                            <span class="spell-tag-inline">{tag}</span>
                        ))
                    }
                </div>
                <span class="spell-stats" style="margin-left: auto;">
                    <span>{minutes} min read</span>
                </span>
            </div>

            <h1 class="article-title">{post.data.title}</h1>

            {
                post.data.description && (
                    <p class="article-description">{post.data.description}</p>
                )
            }

            {
                post.data.image && (
                    <Image
                        src={post.data.image}
                        alt={post.data.title}
                        class="article-cover"
                    />
                )
            }
        </header>

        <div class="prose">
            <Content />
        </div>

        <div class="rune-divider" style="margin-top: 3rem;">
            <span>end of inscription</span>
        </div>

        <!-- Prev / Next navigation -->
        {
            (prevPost || nextPost) && (
                <nav class="post-nav">
                    <div class="post-nav-item post-nav-prev">
                        {nextPost ? (
                            <a href={`/posts/${nextPost.slug}`}>
                                <span class="post-nav-label">← previous</span>
                                <span class="post-nav-title">
                                    {nextPost.data.title}
                                </span>
                            </a>
                        ) : (
                            <span />
                        )}
                    </div>

                    <div class="post-nav-item post-nav-next">
                        {prevPost ? (
                            <a href={`/posts/${prevPost.slug}`}>
                                <span class="post-nav-label">next →</span>
                                <span class="post-nav-title">
                                    {prevPost.data.title}
                                </span>
                            </a>
                        ) : (
                            <span />
                        )}
                    </div>
                </nav>
            )
        }

        <a
            href="/"
            class="article-back"
            style="margin-top: 1rem; display: inline-flex;"
            >← Back to grimoire</a
        >
    </div>
</Base>

<style>
    .post-nav {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--color-border, rgba(255 255 255 / 0.08));
    }

    .post-nav-item {
        flex: 1;
        min-width: 0;
    }

    .post-nav-item a {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
        text-decoration: none;
        color: inherit;
        opacity: 0.7;
        transition: opacity 0.2s ease;
    }

    .post-nav-item a:hover {
        opacity: 1;
    }

    .post-nav-label {
        font-size: 0.72rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--color-accent, #a78bfa);
        font-family: var(--font-mono, monospace);
    }

    .post-nav-title {
        font-size: 0.9rem;
        line-height: 1.4;
        font-weight: 500;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .post-nav-next {
        text-align: right;
    }
</style>
