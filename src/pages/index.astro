---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

// Fetch all non-draft posts, sorted newest first
const allPosts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
    (a, b) => b.data.published.valueOf() - a.data.published.valueOf(),
);

// Estimate reading time (average 200 wpm)
function readingTime(body: string) {
    const words = body.trim().split(/\s+/).length;
    return Math.max(1, Math.round(words / 200));
}

// Is a post "new" — published within the last 14 days
function isNew(date: Date) {
    return Date.now() - date.valueOf() < 14 * 24 * 60 * 60 * 1000;
}

// School CSS class from category name
function schoolClass(category: string) {
    const map: Record<string, string> = {
        Malware: "school-malware",
        "Windows Internals": "school-internals",
    };
    return map[category] ?? "school-default";
}

const newestSlug = allPosts[0]?.slug;
const featuredPosts = allPosts.filter((p) => p.data.featured);
---

<Base title="The Solitär Grimoire">
    <header class="grimoire-header">
        <div class="corner-ornament tl"></div>
        <div class="corner-ornament tr"></div>

        <!-- Sigil -->
        <svg
            class="header-sigil"
            viewBox="0 0 56 56"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
        >
            <circle
                cx="28"
                cy="28"
                r="26"
                stroke="rgba(93,202,165,0.3)"
                stroke-width="0.75"
                stroke-dasharray="4 3"></circle>
            <circle
                cx="28"
                cy="28"
                r="20"
                stroke="rgba(93,202,165,0.15)"
                stroke-width="0.75"></circle>
            <polygon
                points="28,6 50,42 6,42"
                stroke="rgba(93,202,165,0.35)"
                stroke-width="0.75"
                fill="none"></polygon>
            <polygon
                points="28,50 6,14 50,14"
                stroke="rgba(201,168,76,0.2)"
                stroke-width="0.75"
                fill="none"></polygon>
            <circle cx="28" cy="28" r="3.5" fill="rgba(93,202,165,0.7)"
            ></circle>
            <circle
                cx="28"
                cy="28"
                r="6"
                stroke="rgba(93,202,165,0.4)"
                stroke-width="0.75"
                fill="none"></circle>
        </svg>

        <div class="profile-ring">
            <img src="/solitar.webp" alt="Solitär" />
        </div>

        <p class="grimoire-eyebrow">The</p>
        <h1 class="grimoire-title"><em>Solitär</em> Grimoire</h1>
        <p class="grimoire-subtitle">
            Alone among systems — documenting what humans have built, so it may
            be undone
        </p>

        <div class="rune-divider">
            <span>codex · offensive · windows</span>
        </div>
    </header>

    {featuredPosts.length > 0 && (
        <section class="featured-section">
            <div class="featured-header">
                <p class="section-heading" style="margin-bottom:0">Featured Spells</p>
                <div class="featured-arrows">
                    <button class="feat-arrow" id="feat-prev" aria-label="Previous">&#8249;</button>
                    <button class="feat-arrow" id="feat-next" aria-label="Next">&#8250;</button>
                </div>
            </div>
            <div class="featured-track-wrapper">
                <div class="featured-track" id="feat-track">
                    {featuredPosts.map((post) => (
                        <a href={`/posts/${post.slug}`} class="feat-card">
                            {post.data.image
                                ? <img
                                    src={post.data.image.src}
                                    alt={post.data.title}
                                    class="feat-card-img"
                                  />
                                : <div class="feat-card-img feat-card-img--placeholder">
                                    <svg viewBox="0 0 80 60" xmlns="http://www.w3.org/2000/svg" width="48" opacity="0.15">
                                        <polygon points="40,8 72,56 8,56" stroke="rgba(93,202,165,0.6)" stroke-width="1.5" fill="none"/>
                                        <circle cx="40" cy="36" r="6" fill="rgba(93,202,165,0.4)"/>
                                    </svg>
                                  </div>
                            }
                            <div class="feat-card-body">
                                <div class="spell-meta-top" style="margin-bottom:0.4rem">
                                    <span class="spell-date">
                                        {post.data.published.toISOString().slice(0, 10)}
                                    </span>
                                    <span class={`spell-school ${schoolClass(post.data.category)}`}>
                                        {post.data.category}
                                    </span>
                                </div>
                                <h3 class="feat-card-title">{post.data.title}</h3>
                                {post.data.description && (
                                    <p class="feat-card-desc">{post.data.description}</p>
                                )}
                            </div>
                        </a>
                    ))}
                </div>
            </div>
        </section>
    )}

    <div class="home-layout">
        <!-- SPELL ENTRIES GRID -->
        <main class="main-content">
            <p class="section-heading">Recent Incantations</p>

            <div class="spell-grid">
                {
                    allPosts.map((post) => {
                        const minutes = readingTime(post.body);
                        const words = post.body.trim().split(/\s+/).length;
                        const newest = post.slug === newestSlug;
                        const newPost = isNew(post.data.published);

                        return (
                            <a
                                href={`/posts/${post.slug}`}
                                class={`spell-entry${newest ? " featured" : ""}`}
                            >
                                <div class="spell-meta">
                                    <div class="spell-meta-top">
                                        <span class="spell-date">
                                            {post.data.published
                                                .toISOString()
                                                .slice(0, 10)}
                                        </span>
                                        <span
                                            class={`spell-school ${schoolClass(post.data.category)}`}
                                        >
                                            {post.data.category}
                                        </span>
                                        {newPost && (
                                            <span class="new-label">new</span>
                                        )}
                                    </div>
                                    <div class="spell-tags-inline">
                                        {post.data.tags.map((tag) => (
                                            <span class="spell-tag-inline">
                                                {tag}
                                            </span>
                                        ))}
                                    </div>
                                </div>

                                <h2 class="spell-title">{post.data.title}</h2>

                                {post.data.description && (
                                    <p class="spell-incantation">
                                        {post.data.description}
                                    </p>
                                )}

                                <div class="spell-footer">
                                    <span class="spell-read">Read spell →</span>
                                    <div class="spell-stats">
                                        <span>{words} words</span>
                                        <span>{minutes} min</span>
                                    </div>
                                </div>
                            </a>
                        );
                    })
                }
            </div>

            <div class="rune-divider">
                <span>end of current inscriptions</span>
            </div>
        </main>
    </div>
</Base>

<script>
    const track = document.getElementById("feat-track") as HTMLElement | null;
    const prev  = document.getElementById("feat-prev") as HTMLButtonElement | null;
    const next  = document.getElementById("feat-next") as HTMLButtonElement | null;

    if (track && prev && next) {
        const getStep = () => {
            const card = track.querySelector(".feat-card") as HTMLElement | null;
            return card ? card.offsetWidth + 24 : 400; // 24 = gap
        };

        prev.addEventListener("click", () => {
            track.scrollBy({ left: -getStep(), behavior: "smooth" });
        });
        next.addEventListener("click", () => {
            track.scrollBy({ left: getStep(), behavior: "smooth" });
        });

        const updateArrows = () => {
            prev.style.opacity = track.scrollLeft <= 4 ? "0.3" : "1";
            const maxScroll = track.scrollWidth - track.clientWidth;
            next.style.opacity = track.scrollLeft >= maxScroll - 4 ? "0.3" : "1";
        };
        track.addEventListener("scroll", updateArrows, { passive: true });
        updateArrows();
    }
</script>
